{
  "name": "camsAI",
  "displayName": "camsAI - AI Context Handoff",
  "description": "Never lose context when switching AI assistants. camsAI silently tracks your edits and auto-copies a structured handoff prompt the moment you open a different AI chat panel.",
  "version": "1.0.4",
  "publisher": "camsAI",
  "icon": "extension/images/icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "keywords": [
    "ai",
    "context",
    "handoff",
    "copilot",
    "claude",
    "gemini",
    "chatgpt",
    "cline",
    "camsAI",
    "productivity"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/camsAI-vscode/camsAI.git"
  },
  "bugs": {
    "url": "https://github.com/camsAI-vscode/camsAI/issues"
  },
  "homepage": "https://github.com/camsAI-vscode/camsAI#readme",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "camsAI.startTask",
        "title": "camsAI: Name Current Session",
        "category": "camsAI"
      },
      {
        "command": "camsAI.renameTask",
        "title": "camsAI: Rename Current Session",
        "category": "camsAI"
      },
      {
        "command": "camsAI.snapshotTask",
        "title": "camsAI: Save Context Snapshot",
        "category": "camsAI"
      },
      {
        "command": "camsAI.continueTask",
        "title": "camsAI: Continue Task In...",
        "category": "camsAI"
      },
      {
        "command": "camsAI.endTask",
        "title": "camsAI: End Session",
        "category": "camsAI"
      },
      {
        "command": "camsAI.configureAI",
        "title": "camsAI: Configure Pro",
        "category": "camsAI"
      },
      {
        "command": "camsAI.refreshTier",
        "title": "camsAI: Refresh Tier Indicator",
        "category": "camsAI"
      },
      {
        "command": "camsAI.openSidebar",
        "title": "camsAI: Open Panel",
        "category": "camsAI"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "camsAI-container",
          "title": "camsAI",
          "icon": "extension/images/icon.png"
        }
      ]
    },
    "views": {
      "camsAI-container": [
        {
          "type": "webview",
          "id": "camsAI.sidebar",
          "name": "camsAI"
        }
      ]
    },
    "configuration": {
      "title": "camsAI",
      "properties": {
        "camsAI.offlineMode": {
          "type": "boolean",
          "default": false,
          "description": "Disable all network calls. AI extraction and enrichment are skipped."
        },
        "camsAI.capture.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Capture workspace file edits while a camsAI session is active."
        },
        "camsAI.capture.maxDiffChars": {
          "type": "number",
          "default": 20000,
          "minimum": 1000,
          "description": "Maximum number of characters stored for a single file diff."
        },
        "camsAI.capture.flushIntervalMs": {
          "type": "number",
          "default": 3000,
          "minimum": 500,
          "description": "Debounce interval (ms) before persisting a captured file edit."
        },
        "camsAI.prompt.maxChars": {
          "type": "number",
          "default": 30000,
          "minimum": 4000,
          "description": "Maximum character budget for generated handoff prompts."
        },
        "camsAI.session.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start a rolling session when VS Code opens."
        },
        "camsAI.session.idleTimeoutMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "description": "Reserved for future idle-rotation behaviour. Currently informational."
        },
        "camsAI.session.autoHandoffOnAssistantSwitch": {
          "type": "boolean",
          "default": true,
          "description": "Automatically copy a handoff prompt to the clipboard when you switch AI assistant panels."
        },
        "camsAI.ai.enrichHandoff": {
          "type": "boolean",
          "default": true,
          "description": "Enrich auto-handoffs and snapshots with AI-inferred goal, decisions, assumptions, and pending items."
        },
        "camsAI.ai.autoExtractOnSnapshot": {
          "type": "boolean",
          "default": true,
          "description": "Automatically run AI extraction when you save a context snapshot."
        },
        "camsAI.ai.serviceUrl": {
          "type": "string",
          "default": "",
          "description": "Override the camsAI extraction service URL (leave blank to use the default)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "tsc -p ./ && node --test out/test/parseExtraction.test.js out/test/promptEngine.test.js out/test/enrichment.test.js out/test/decisionCapture.test.js out/test/workspaceIsolation.test.js out/test/backgroundEnricher.test.js",
    "package": "vsce package"
  },
  "dependencies": {
    "diff": "^5.2.0"
  },
  "devDependencies": {
    "@types/diff": "^5.2.3",
    "@types/node": "^20.17.6",
    "@types/sql.js": "^1.4.9",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.2.1",
    "sql.js": "^1.12.0",
    "typescript": "^5.6.3"
  }
}